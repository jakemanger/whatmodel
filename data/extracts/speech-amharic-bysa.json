  "benchmarks": [
    {
      "id": "amharic-addis-primary87-cer",
      "name": "Amharic TTS · 87-prompt CER (Chirp 3 judge)",
      "kind": "err",
      "category": "tts",
      "url": "https://huggingface.co/datasets/addisai/amharic-tts-benchmark/blob/a60556cd62dd2fbfce83a09c11b088e1e027ce64/data/summary.json",
      "metric": "character_error_rate",
      "setup": "2026-08-12. 100 fixed-seed test prompts: FLEURS34, Waxal33, Horn-ASR33; 87 without digits in primary table. Generated audio judged by Google Chirp3 after 16kHz mono conversion. NFC, punctuation removal, lowercasing, Ethiopic homophone folding, whitespace collapse; CER removes spaces. Micro sum of character edits/reference characters (8152). No audio imported.",
      "sample_count": 87,
      "score_unit": "error ratio; can exceed 1.0",
      "caveats": [
        "Single run; model aliases can change after the run.",
        "OpenAI and ElevenLabs rows are unsupported-language conditions, not general TTS-quality claims.",
        "Google Gemini is judged with Google Chirp3; this is not a vendor-independent recognizer for that row.",
        "WER retained as companion metadata, not another ranked result; full100 aggregate and slices excluded.",
        "An error ratio above 1.0 is valid with insertions; preserve it. Current app fit clamps 1-error at its probability floor, which should not alter stored raw measurement."
      ]
    }
  ],
