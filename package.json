{
  "name": "whatmodel",
  "version": "0.1.0",
  "private": true,
  "description": "Open data, scoring and bench script behind whatmodel.sh",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "contrib:review": "node scripts/contrib/cli.ts",
    "contrib:forms": "node scripts/contrib/forms.ts",
    "contributor": "node scripts/contributor.ts",
    "check": "node scripts/check.ts",
    "validate-data": "node scripts/check.ts --validate-only",
    "test": "node --test tests/*.test.ts",
    "test:bench": "python3 -m unittest discover -s tests/bench",
    "typecheck": "tsc --noEmit",
    "board": "node scripts/board.ts",
    "pages": "node scripts/pages.ts",
    "hf": "node scripts/hf.ts",
    "export": "node scripts/export-data.ts",
    "import": "node scripts/import.ts",
    "provenance": "node scripts/provenance.ts",
    "quality": "node scripts/quality.ts",
    "score-coverage": "node scripts/score-coverage.ts",
    "calibrate": "node scripts/calibrate.ts",
    "icons": "node scripts/icons.ts",
    "kv": "node scripts/kv.ts",
    "llmfit": "node scripts/llmfit.ts",
    "measure-api": "node --env-file=.env.local scripts/measure-api.ts"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
